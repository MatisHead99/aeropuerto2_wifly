<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <!-- Unidad de persistencia: el DataSource se configura en WildFly (ver scripts/configurar-wildfly.cli) -->
    <persistence-unit name="aeropuertoPU" transaction-type="JTA">
        <jta-data-source>java:/jdbc/AeropuertoDS</jta-data-source>

        <class>com.etitc.aeropuerto2.models.Vuelo</class>
        <class>com.etitc.aeropuerto2.models.Tiquete</class>
        <class>com.etitc.aeropuerto2.models.Personal</class>
        <class>com.etitc.aeropuerto2.models.Asignacion</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- validate: Hibernate comprueba que las entidades coinciden con sql/schema.sql y no crea ni borra tablas -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
