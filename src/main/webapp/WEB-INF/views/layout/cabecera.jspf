<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><c:out value="${titulo}"/> - Sistema de Aeropuerto 2</title>
    <link rel="stylesheet" href="${ctx}/css/styles.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="header-brand">
                <h1>✈️ Sistema de Aeropuerto 2</h1>
            </div>
            <div class="header-user">
                <span>Bienvenido, <strong><c:out value="${sessionScope.nombreUsuario}"/></strong></span>
                <a href="${ctx}/app/logout" class="btn btn-small btn-danger">Salir</a>
            </div>
        </header>

        <nav class="sidebar">
            <ul class="nav-menu">
                <li><a href="${ctx}/app/dashboard" class="${activo == 'dashboard' ? 'active' : ''}">📊 Dashboard</a></li>
                <li><a href="${ctx}/app/vuelos" class="${activo == 'vuelos' ? 'active' : ''}">✈️ Vuelos</a></li>
                <li><a href="${ctx}/app/tiquetes" class="${activo == 'tiquetes' ? 'active' : ''}">🎫 Tiquetes</a></li>
                <li><a href="${ctx}/app/asignaciones" class="${activo == 'asignaciones' ? 'active' : ''}">🧑‍✈️ Asignaciones</a></li>
                <li><a href="${ctx}/app/seleccion" class="${activo == 'seleccion' ? 'active' : ''}">⭐ Selección</a></li>
                <li><a href="${ctx}/app/personal" class="${activo == 'personal' ? 'active' : ''}">👥 Personal</a></li>
            </ul>
        </nav>

        <main class="main-content">
            <c:if test="${not empty error}">
                <div class="alert alert-error"><c:out value="${error}"/></div>
            </c:if>
            <c:if test="${param.ok == '1'}">
                <div class="alert alert-success">Operación realizada correctamente.</div>
            </c:if>
